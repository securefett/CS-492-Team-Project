[gd_scene format=3 uid="uid://sales"]

[ext_resource type="Script" uid="uid://vt2nagoll8ik" path="res://src/Main/scripts/pages/Sales.gd" id="1"]

[node name="Sales" type="HBoxContainer"]
anchor_right = 1.0
