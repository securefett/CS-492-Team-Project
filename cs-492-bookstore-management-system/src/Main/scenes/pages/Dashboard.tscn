[gd_scene format=3 uid="uid://dashboard"]

[ext_resource type="Script" uid="uid://4t1kpt2g0mwt" path="res://src/Main/scripts/pages/Dashboard.gd" id="1"]

[node name="Dashboard" type="ScrollContainer"]
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
size_flags_horizontal = 3
theme_override_constants/separation = 20

; ── Metric cards row ──────────────────────────────────────────────────────────
[node name="MetricsRow" type="HBoxContainer" parent="Content"]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="CardSales" type="PanelContainer" parent="Content/MetricsRow"]
size_flags_horizontal = 3

[node name="CardSalesLayout" type="VBoxContainer" parent="Content/MetricsRow/CardSales"]
[node name="SalesLabel" type="Label" parent="Content/MetricsRow/CardSales/CardSalesLayout"]
text = "Total Sales"
[node name="SalesValue" type="Label" parent="Content/MetricsRow/CardSales/CardSalesLayout"]
text = "$8,241"
[node name="SalesDelta" type="Label" parent="Content/MetricsRow/CardSales/CardSalesLayout"]
text = "↑ 12% this month"

[node name="CardBooks" type="PanelContainer" parent="Content/MetricsRow"]
size_flags_horizontal = 3

[node name="CardBooksLayout" type="VBoxContainer" parent="Content/MetricsRow/CardBooks"]
[node name="BooksLabel" type="Label" parent="Content/MetricsRow/CardBooks/CardBooksLayout"]
text = "Books Sold"
[node name="BooksValue" type="Label" parent="Content/MetricsRow/CardBooks/CardBooksLayout"]
text = "312"
[node name="BooksDelta" type="Label" parent="Content/MetricsRow/CardBooks/CardBooksLayout"]
text = "↑ 8% this month"

[node name="CardInventory" type="PanelContainer" parent="Content/MetricsRow"]
size_flags_horizontal = 3

[node name="CardInventoryLayout" type="VBoxContainer" parent="Content/MetricsRow/CardInventory"]
[node name="InventoryLabel" type="Label" parent="Content/MetricsRow/CardInventory/CardInventoryLayout"]
text = "Inventory"
[node name="InventoryValue" type="Label" parent="Content/MetricsRow/CardInventory/CardInventoryLayout"]
text = "1,084"
[node name="InventoryDelta" type="Label" parent="Content/MetricsRow/CardInventory/CardInventoryLayout"]
text = "Across 247 titles"

[node name="CardCustomers" type="PanelContainer" parent="Content/MetricsRow"]
size_flags_horizontal = 3

[node name="CardCustomersLayout" type="VBoxContainer" parent="Content/MetricsRow/CardCustomers"]
[node name="CustomersLabel" type="Label" parent="Content/MetricsRow/CardCustomers/CardCustomersLayout"]
text = "Customers"
[node name="CustomersValue" type="Label" parent="Content/MetricsRow/CardCustomers/CardCustomersLayout"]
text = "156"
[node name="CustomersDelta" type="Label" parent="Content/MetricsRow/CardCustomers/CardCustomersLayout"]
text = "↑ 5 new this week"

; ── Bottom row: Top books | Genre breakdown ───────────────────────────────────
[node name="BottomRow" type="HBoxContainer" parent="Content"]
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="TopBooksCard" type="PanelContainer" parent="Content/BottomRow"]
size_flags_horizontal = 3

[node name="TopBooksLayout" type="VBoxContainer" parent="Content/BottomRow/TopBooksCard"]
[node name="TopBooksTitle" type="Label" parent="Content/BottomRow/TopBooksCard/TopBooksLayout"]
text = "Top Selling Books"
[node name="TopBooksList" type="VBoxContainer" parent="Content/BottomRow/TopBooksCard/TopBooksLayout"]
; Rows added dynamically by Dashboard.gd

[node name="GenreCard" type="PanelContainer" parent="Content/BottomRow"]
size_flags_horizontal = 3

[node name="GenreLayout" type="VBoxContainer" parent="Content/BottomRow/GenreCard"]
[node name="GenreTitle" type="Label" parent="Content/BottomRow/GenreCard/GenreLayout"]
text = "Sales by Genre"
[node name="GenreList" type="VBoxContainer" parent="Content/BottomRow/GenreCard/GenreLayout"]
; Rows added dynamically by Dashboard.gd
